>>>>>>> f436dee2145d0f9cf43231c3354d45f581522a8e
    }

    function validUserRole(role) {
      return role in ['student', 'driver'];
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly(["role", "name", "photoURL", "createdAt", "updatedAt", "email", "linkedAt"])
        && request.resource.data.role is string
        && validUserRole(request.resource.data.role)
        && (request.resource.data.name == null || request.resource.data.name is string)
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && (request.resource.data.email == null || request.resource.data.email is string)
        && (request.resource.data.linkedAt == null || request.resource.data.linkedAt is timestamp)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && validUserDocument();

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && validUserDocument()
        && resource.data.role == request.resource.data.role;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
