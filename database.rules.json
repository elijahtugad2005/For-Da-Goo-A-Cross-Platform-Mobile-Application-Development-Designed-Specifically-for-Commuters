{
  "rules": {
    "locations": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && auth.uid === $userId"
      }
    },
    "sharedLocations": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && auth.uid === $userId"
      }
    }
  }
}
